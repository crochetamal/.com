rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      // استبدلي البريد ببريد حساب المسؤولة في Firebase Authentication
      allow write: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL@example.com';
    }
  }
}
