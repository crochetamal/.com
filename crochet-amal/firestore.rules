rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'crochetamal64@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Retain the existing site policy without granting broad write access.
    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
