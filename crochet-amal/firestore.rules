rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      // السماح بالكتابة لحساب المسؤولة المسجّل في Firebase Authentication
      allow write: if request.auth != null
        && request.auth.token.email == 'crochetamal64@gmail.com';
    }
    match /site/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'crochetamal64@gmail.com';
    }
  }
}
